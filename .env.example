# Copy this file to .env and fill in your key. .env is git-ignored - never commit it.
#
# Needed ONLY for real LLM extraction (Phase 4, extraction_backend: openai).
# The mock extractor (extraction_backend: mock, the default), the selection
# strategies and all tests need NO API key.
OPENAI_API_KEY=

# OPTIONAL - use a free OpenAI-compatible provider instead of OpenAI (pilot only).
# Gemini free tier: put your Google AI Studio key in OPENAI_API_KEY above, then set:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# and run configs/pilot_hotpotqa_free.yaml.

# Optional pacing for low-rate-limit providers (free tiers): min seconds between LLM calls.
# LLM_MIN_INTERVAL_S=7
